; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WW1 Tower Defense"
run/main_scene="res://scenes/lobby.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/game_manager.gd"
WaveManager="*res://scripts/wave_manager.gd"
EconomyManager="*res://scripts/economy_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1672
window/size/viewport_height=941
window/size/mode=4
window/size/resizable=false
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
